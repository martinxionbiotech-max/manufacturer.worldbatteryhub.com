---
import manufacturers from '../data/manufacturers.json';

const SITE = 'https://manufacturer.worldbatteryhub.com';
const items = manufacturers.manufacturers;

const VERIFICATION_LABELS = {
  claimed: 'Claimed',
  'certificate-backed': 'Certificate-backed',
  'independently-verified': 'Independently verified',
};
const levelLabel = (m) => VERIFICATION_LABELS[m.verification_level || 'claimed'] || (m.verification_level || 'claimed');
---

<!DOCTYPE html>
