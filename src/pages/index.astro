    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Battery Manufacturer Directory | World Battery Hub</title>
    <meta name="description" content="Battery manufacturer directory — verified company data for lead-acid and lithium battery makers, each with an entity page and a claimed-vs-accredited verification status." />
    <link rel="canonical" href={`${SITE}/`} />
