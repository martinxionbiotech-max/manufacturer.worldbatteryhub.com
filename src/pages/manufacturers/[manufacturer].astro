---
import manufacturers from '../../data/manufacturers.json';

export function getStaticPaths() {
  return manufacturers.manufacturers.map((m) => ({
    params: { manufacturer: m.id },
    props: { manufacturer: m },
  }));
}

const { manufacturer } = Astro.props;
const SITE = 'https://manufacturer.worldbatteryhub.com';
const url = `${SITE}/manufacturers/${manufacturer.id}/`;

// Three-level verification state (claimed / certificate-backed / independently-verified).
// Default is 'claimed' — no certification is credited beyond what is recorded.
const VERIFICATION_LABELS = {
  claimed: 'Claimed',
  'certificate-backed': 'Certificate-backed',
  'independently-verified': 'Independently verified',
};
const verificationLevel = manufacturer.verification_level || 'claimed';
const verificationLabel = VERIFICATION_LABELS[verificationLevel] || verificationLevel;

// Four-dimension verification levels (audit #3 P0-3): Level 0-4 per dimension
const LEVEL_LABELS = {
  unverified: 'Unverified (Level 0)',
  claimed: 'Claimed (Level 0)',
  publicly_identified: 'Publicly identified (Level 1)',
  cross_verified: 'Cross-verified (Level 2)',
  first_party: 'First-party verified (Level 3)',
  certificate_backed: 'Certificate-backed (Level 3)',
  independently_verified: 'Independently verified (Level 4)',
};
const lv = manufacturer.verification_levels || {};
const dimLabel = (k) => LEVEL_LABELS[lv[k]] || 'Publicly identified (Level 1)';

// Intelligence fields (audit #3 P1 item 6) — render only where evidence exists.
const INTELLIGENCE_KEYS = ['cell_formats', 'markets', 'brands', 'subsidiaries', 'oem_relationships'];
const hasIntelligence = INTELLIGENCE_KEYS.some((k) => manufacturer[k] && manufacturer[k].length);

const orgJsonLd = {
  '@type': 'Organization',
  '@id': `${url}#org`,
  name: manufacturer.name,
  url: SITE,
  location: { '@type': 'Country', name: manufacturer.country },
  ...(manufacturer.founded ? { foundingDate: String(manufacturer.founded) } : {}),
  description: `${manufacturer.name} (${manufacturer.chinese || manufacturer.country}) — ${manufacturer.chemistry} battery maker: ${manufacturer.products}.`,
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{manufacturer.name} — Battery Manufacturer | World Battery Hub</title>
    <meta name="description" content={`${manufacturer.name}${manufacturer.chinese ? ` (${manufacturer.chinese})` : ''} — ${manufacturer.chemistry} battery manufacturer (${manufacturer.products}).`} />
    <link rel="canonical" href={url} />
    <style>
      body { font-family: system-ui, sans-serif; margin: 0; color: #1e293b; line-height: 1.6; }
      .container { max-width: 900px; margin: 0 auto; padding: 20px; }
      h1, h2 { color: #0f1f3d; }
      a { color: #1d4ed8; }
      .muted { color: #64748b; font-size: 0.85rem; }
      .box { background: #eff6ff; border-left: 4px solid #1d4ed8; padding: 12px 16px; margin: 14px 0; }
      .warn { background: #fffbeb; border: 1px solid #fde68a; border-radius: 6px; padding: 12px 16px; margin: 14px 0; }
      table { width: 100%; border-collapse: collapse; font-size: 0.95rem; }
      th, td { text-align: left; padding: 8px 10px; border-bottom: 1px solid #e5e9f0; }
      th { color: #0f1f3d; width: 32%; }
      .related { display: flex; flex-wrap: wrap; gap: 8px; }
      .related a { background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 4px; padding: 4px 10px; text-decoration: none; font-size: 0.9rem; }
    </style>
    <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />
  
    <script type="application/ld+json" set:html={"{\"@context\": \"https://schema.org\", \"@type\": \"WebPage\", \"@id\": \"https://manufacturer.worldbatteryhub.com/manufacturers/\", \"url\": \"https://manufacturer.worldbatteryhub.com/manufacturers/\", \"name\": \"Manufacturers\", \"publisher\": {\"@id\": \"https://worldbatteryhub.com/#organization\"}, \"isPartOf\": {\"@id\": \"https://manufacturer.worldbatteryhub.com/\"}}"} />
    <script type="application/ld+json" set:html={"{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Battery Manufacturers\", \"item\": \"https://manufacturer.worldbatteryhub.com/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Manufacturers\", \"item\": \"https://manufacturer.worldbatteryhub.com/manufacturers/\"}]}"} />
  </head>
  <body>
    <div class="container">
      <p class="muted"><a href="/">← Manufacturer Directory</a> · Entity: <strong>Organization</strong></p>
      <h1>{manufacturer.name}{manufacturer.chinese ? ` (${manufacturer.chinese})` : ''}</h1>

      <div class="box">
        <strong>Direct answer:</strong> {manufacturer.name} is a {manufacturer.chemistry} battery manufacturer
        headquartered in {manufacturer.hq}, {manufacturer.country}, making {manufacturer.products}.
      </div>

      <h2>Quick facts</h2>
      <table>
        <tbody>
          <tr><th>Company</th><td>{manufacturer.name}{manufacturer.chinese ? ` (${manufacturer.chinese})` : ''}</td></tr>
          <tr><th>Country</th><td>{manufacturer.country}</td></tr>
          <tr><th>Headquarters</th><td>{manufacturer.hq}</td></tr>
          <tr><th>Chemistry</th><td>{manufacturer.chemistry}</td></tr>
          <tr><th>Products</th><td>{manufacturer.products}</td></tr>
          {manufacturer.founded && <tr><th>Founded</th><td>{manufacturer.founded}</td></tr>}
          {manufacturer.ownership && <tr><th>Ownership</th><td>{manufacturer.ownership}</td></tr>}
          {manufacturer.listed && <tr><th>Listed</th><td>{manufacturer.listed}</td></tr>}
        </tbody>
      </table>

      {hasIntelligence && (
        <h2>Company intelligence</h2>
        <table>
          <tbody>
            {manufacturer.cell_formats && <tr><th>Cell formats</th><td>{manufacturer.cell_formats.join(', ')}</td></tr>}
            {manufacturer.markets && <tr><th>Markets</th><td>{manufacturer.markets.join(', ')}</td></tr>}
            {manufacturer.brands && <tr><th>Brands</th><td>{manufacturer.brands.join(', ')}</td></tr>}
            {manufacturer.subsidiaries && <tr><th>Subsidiaries</th><td>{manufacturer.subsidiaries.join(', ')}</td></tr>}
            {manufacturer.oem_relationships && <tr><th>OEM relationships</th><td>{manufacturer.oem_relationships.join(', ')}</td></tr>}
          </tbody>
        </table>
        <p class="muted">Fields are populated only where a public source supports the value; an absent field means the evidence was not found, not that the fact is false. See the <a href="https://worldbatteryhub.com/methodology/">methodology</a>.</p>
      )}

      <h2>Technology focus</h2>
      <p>
        {manufacturer.name} works in <strong>{manufacturer.chemistry}</strong>. See the
        <a href="https://technology.worldbatteryhub.com">Battery Technology Reference</a> for the design
        trade-offs behind the chemistry label, and the
        <a href="https://worldbatteryhub.com/lead-acid/types/">lead-acid type family</a> for the technology
        variants.
      </p>

      <h2>Product portfolio</h2>
      <p>
        The product range covers <strong>{manufacturer.products}</strong>. Application context:
        <a href="https://worldbatteryhub.com/lead-acid/">lead-acid applications</a> and
        <a href="https://worldbatteryhub.com/lithium/">lithium applications</a>.
      </p>

      <h2>Verification</h2>
      <div class="warn">
        <p><strong>Overall level:</strong> {verificationLabel}</p>
        <table>
          <tbody>
            <tr><th>Company identity</th><td>{dimLabel('identity')}</td></tr>
            <tr><th>Manufacturing capability</th><td>{dimLabel('capability')}</td></tr>
            <tr><th>Product portfolio</th><td>{dimLabel('products')}</td></tr>
            <tr><th>Certifications</th><td>{dimLabel('certifications')}</td></tr>
          </tbody>
        </table>
        <p><strong>Notes:</strong> {manufacturer.verification.company} · {manufacturer.verification.certifications}</p>
        <p class="muted">Each dimension is rated independently — a company may be publicly identified while its certifications remain claims. See the <a href="/verification-criteria/">verification criteria</a>.</p>
      </div>
      <p class="muted">Last verified: {manufacturer.verification.date || '2026-09'}</p>

      <h2>Related</h2>
      <div class="related">
        <a href="/">Manufacturer directory</a>
        <a href="/china-lead-acid-manufacturers/">China lead-acid manufacturers</a>
        <a href="/lithium-ev-manufacturers/">Lithium EV manufacturers</a>
        <a href="https://market.worldbatteryhub.com/battery-market-overview/">Market overview</a>
        <a href="https://worldbatteryhub.com">World Battery Hub</a>
      </div>

      <p class="muted">Return to <a href="https://manufacturer.worldbatteryhub.com">Battery Manufacturer Directory</a>. Data is researched from public sources and cross-verified; it is informational, not purchasing advice.</p>
    </div>
  </body>
</html>
